# Authentication (required)
API_KEY=your-api-key-here
ADMIN_API_KEY=your-admin-api-key-here

# Storage
DATA_DIR=./data
MAX_ROWS=10000
MAX_UPLOAD_SIZE=524288000

# Logging
LOG_LEVEL=INFO

# Cache settings
CACHE_MAX_SIZE=2000
CACHE_TTL=2592000

# Query timeout (ms)
QUERY_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_BURST=20/second
RATE_LIMIT_SUSTAINED=500/minute

# Optional: API monitoring (tigzig-api-monitor)
API_MONITOR_URL=
API_MONITOR_KEY=
